"""
data_fetch.py
-------------
Pulls daily historical weather data for Copenhagen from the Open-Meteo
Archive API (free, no API key required).

Open-Meteo docs: https://open-meteo.com/en/docs/historical-weather-api
"""

import requests
import pandas as pd

# Copenhagen coordinates
LATITUDE = 55.6761
LONGITUDE = 12.5683

# Daily variables we want. Open-Meteo aggregates hourly reanalysis
# (ERA5 / ERA5-Land) data into these daily summaries for us.
DAILY_VARS = [
    "temperature_2m_max",
    "temperature_2m_min",
    "temperature_2m_mean",
    "precipitation_sum",
    "rain_sum",
    "windspeed_10m_max",
    "winddirection_10m_dominant",
    "windgusts_10m_max",
    "surface_pressure_mean",
    "relative_humidity_2m_mean",
    "cloudcover_mean",
]

ARCHIVE_URL = "https://archive-api.open-meteo.com/v1/archive"


def fetch_history(start_date: str, end_date: str) -> pd.DataFrame:
    """
    Fetch daily historical weather for Copenhagen between start_date and
    end_date (format: 'YYYY-MM-DD'). Returns a tidy DataFrame, one row
    per day.
    """
    params = {
        "latitude": LATITUDE,
        "longitude": LONGITUDE,
        "start_date": start_date,
        "end_date": end_date,
        "daily": ",".join(DAILY_VARS),
        "timezone": "Europe/Copenhagen",
    }
    resp = requests.get(ARCHIVE_URL, params=params, timeout=60)
    resp.raise_for_status()
    payload = resp.json()

    df = pd.DataFrame(payload["daily"])
    df["time"] = pd.to_datetime(df["time"])
    df = df.rename(columns={"time": "date"})
    df = df.sort_values("date").reset_index(drop=True)
    return df


def fetch_hourly_precip_max(start_date: str, end_date: str) -> pd.DataFrame:
    """
    Fetch hourly precipitation and reduce it to, per day, the maximum
    1-hour precipitation total.

    Why this matters: Danish meteorological practice defines a
    "skybrud" (cloudburst) as >15mm in 30 minutes -- a burst-intensity
    threshold, not a daily total. Open-Meteo doesn't give sub-hourly
    resolution, but max-hourly-precip is a much closer proxy to the
    real definition than a 24-hour sum, which can hide a genuine
    cloudburst inside an otherwise unremarkable day, or flag a long,
    gentle, all-day drizzle as "extreme" when it never actually burst.
    """
    params = {
        "latitude": LATITUDE,
        "longitude": LONGITUDE,
        "start_date": start_date,
        "end_date": end_date,
        "hourly": "precipitation",
        "timezone": "Europe/Copenhagen",
    }
    resp = requests.get(ARCHIVE_URL, params=params, timeout=60)
    resp.raise_for_status()
    payload = resp.json()

    hourly = pd.DataFrame(payload["hourly"])
    hourly["time"] = pd.to_datetime(hourly["time"])
    hourly["date"] = hourly["time"].dt.floor("D")

    daily_max = (
        hourly.groupby("date")["precipitation"]
        .max()
        .rename("precip_max_1h")
        .reset_index()
    )
    return daily_max


if __name__ == "__main__":
    # 10 years of history is enough to see real seasonal + extreme-event
    # patterns without the request getting too large.
    df = fetch_history("2015-01-01", "2024-12-31")
    hourly_max = fetch_hourly_precip_max("2015-01-01", "2024-12-31")
    df = df.merge(hourly_max, on="date", how="left")

    df.to_csv("copenhagen_daily_weather.csv", index=False)
    print(f"Saved {len(df)} rows to copenhagen_daily_weather.csv")
    print(df.head())
