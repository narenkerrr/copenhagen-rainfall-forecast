"""
model.py
--------
Trains and compares three things for predicting extreme-rainfall days
in Copenhagen:

1. Climatology baseline: the seasonal historical extreme-rain rate.
   The real bar for "the ML model adds value."
2. A calibrated gradient-boosted classifier.
3. A stacked model: climatology + gradient-boosting predictions fed
   into a logistic regression, so the ML model effectively learns a
   *residual correction* on top of the seasonal norm rather than
   having to relearn seasonality from scratch.

Uses purged time-series cross-validation (not a single train/test
split, and not plain random k-fold) because:
  - a random split leaks future information into the past for
    autocorrelated time-series data
  - even a naive time-ordered split can leak a little, because lag
    and rolling-window features near a fold boundary are computed
    from data that straddles train and validation -- "purging" a
    small gap around each split removes that leakage.
"""

import numpy as np
import pandas as pd
from sklearn.ensemble import HistGradientBoostingClassifier
from sklearn.calibration import CalibratedClassifierCV
from sklearn.linear_model import LogisticRegression
from sklearn.inspection import permutation_importance
from sklearn.metrics import (
    roc_auc_score,
    average_precision_score,
    brier_score_loss,
    classification_report,
)

from features import build_features

MAX_LAG_WINDOW = 14  # matches the largest rolling/lag window in features.py


class PurgedTimeSeriesSplit:
    """
    Time-ordered k-fold cross-validation with a purge gap around each
    validation fold, so lag/rolling features can't leak across the
    train/validation boundary.

    Deliberately the simplest version that removes the main leakage
    risk (not a full research-grade implementation with embargoes on
    both sides) -- a project you're presenting should only contain
    code you can defend in an interview.
    """

    def __init__(self, n_splits: int = 5, purge_gap: int = MAX_LAG_WINDOW):
        self.n_splits = n_splits
        self.purge_gap = purge_gap

    def split(self, dates: pd.Series):
        n = len(dates)
        fold_size = n // (self.n_splits + 1)

        for i in range(1, self.n_splits + 1):
            val_start = fold_size * i
            val_end = min(val_start + fold_size, n)
            train_end = max(val_start - self.purge_gap, 0)

            train_idx = np.arange(0, train_end)
            val_idx = np.arange(val_start, val_end)
            if len(train_idx) == 0 or len(val_idx) == 0:
                continue
            yield train_idx, val_idx


def climatology_baseline(train: pd.DataFrame, query_dates: pd.Series) -> np.ndarray:
    """Seasonal historical extreme-rain rate within a +/-7 day
    day-of-year window, computed from `train` only."""
    train = train.copy()
    train["doy"] = train["date"].dt.dayofyear

    preds = []
    for d in query_dates:
        doy = d.dayofyear
        window = ((train["doy"] - doy + 182) % 365 - 182).abs() <= 7
        rate = train.loc[window, "extreme_rain_tomorrow"].mean()
        preds.append(rate if not np.isnan(rate) else train["extreme_rain_tomorrow"].mean())
    return np.array(preds)


def time_split(df: pd.DataFrame, test_year: int = 2024):
    train = df[df["date"].dt.year < test_year]
    test = df[df["date"].dt.year == test_year]
    return train, test


def report(name: str, y_true, y_pred):
    print(f"=== {name} ===")
    print(f"ROC-AUC: {roc_auc_score(y_true, y_pred):.3f}")
    print(f"PR-AUC : {average_precision_score(y_true, y_pred):.3f}")
    print(f"Brier  : {brier_score_loss(y_true, y_pred):.4f}\n")


def cross_validate(df: pd.DataFrame, feature_cols: list, n_splits: int = 5):
    """Purged time-series CV, used for model selection / sanity-checking
    stability across periods -- NOT for the final headline numbers,
    which come from the held-out final year (see main())."""
    cv = PurgedTimeSeriesSplit(n_splits=n_splits)
    scores = []
    for fold, (train_idx, val_idx) in enumerate(cv.split(df["date"])):
        X_train, y_train = df.iloc[train_idx][feature_cols], df.iloc[train_idx]["extreme_rain_tomorrow"]
        X_val, y_val = df.iloc[val_idx][feature_cols], df.iloc[val_idx]["extreme_rain_tomorrow"]

        if y_train.nunique() < 2:
            continue

        clf = HistGradientBoostingClassifier(
            max_depth=4, learning_rate=0.05, max_iter=300,
            class_weight="balanced", random_state=42,
        )
        clf.fit(X_train, y_train)
        preds = clf.predict_proba(X_val)[:, 1]
        auc = roc_auc_score(y_val, preds) if y_val.nunique() > 1 else np.nan
        scores.append(auc)
        print(f"  fold {fold}: n_train={len(train_idx)} n_val={len(val_idx)} ROC-AUC={auc:.3f}")

    print(f"Purged CV mean ROC-AUC: {np.nanmean(scores):.3f} (+/- {np.nanstd(scores):.3f})\n")


def main():
    raw = pd.read_csv("copenhagen_daily_weather.csv", parse_dates=["date"])
    df, feature_cols = build_features(raw)

    print(">> Purged time-series cross-validation (model stability check)")
    cross_validate(df, feature_cols)

    # --- final held-out evaluation on the most recent year ---
    train, test = time_split(df, test_year=2024)
    X_train, y_train = train[feature_cols], train["extreme_rain_tomorrow"]
    X_test, y_test = test[feature_cols], test["extreme_rain_tomorrow"]

    print(f"Train: {len(train)} days | Test: {len(test)} days | base rate: {y_test.mean():.3%}\n")

    # 1. climatology
    clim_preds = climatology_baseline(train, test["date"])
    report("Climatology baseline", y_test, clim_preds)

    # 2. calibrated gradient-boosted model
    # class_weight="balanced" fixes the class-imbalance ranking problem
    # but distorts the *probabilities* themselves (pushes them toward
    # 0/1). CalibratedClassifierCV re-maps them back to realistic
    # frequencies using cross-validated isotonic regression.
    base_clf = HistGradientBoostingClassifier(
        max_depth=4, learning_rate=0.05, max_iter=300,
        class_weight="balanced", random_state=42,
    )
    calibrated_clf = CalibratedClassifierCV(base_clf, method="isotonic", cv=3)
    calibrated_clf.fit(X_train, y_train)
    model_preds = calibrated_clf.predict_proba(X_test)[:, 1]
    report("Calibrated gradient-boosted model", y_test, model_preds)

    print(classification_report(y_test, model_preds > 0.5, zero_division=0))

    # 3. stacked: climatology + ML as inputs to a residual-learning logistic regression
    clim_train = climatology_baseline(train, train["date"])
    stack_X_train = np.column_stack([clim_train, calibrated_clf.predict_proba(X_train)[:, 1]])
    stack_X_test = np.column_stack([clim_preds, model_preds])

    stacker = LogisticRegression()
    stacker.fit(stack_X_train, y_train)
    stacked_preds = stacker.predict_proba(stack_X_test)[:, 1]
    report("Stacked (climatology + ML residual learner)", y_test, stacked_preds)
    print(f"Stacker weights -- climatology: {stacker.coef_[0][0]:.3f}, ML: {stacker.coef_[0][1]:.3f}\n")

    # feature importance via permutation (model-agnostic; works for the
    # calibrated wrapper too)
    perm = permutation_importance(
        calibrated_clf, X_test, y_test, n_repeats=10, random_state=42, scoring="roc_auc"
    )
    importances = pd.Series(perm.importances_mean, index=feature_cols)
    print("Top 10 features (permutation importance):")
    print(importances.sort_values(ascending=False).head(10))

    return calibrated_clf, stacker, feature_cols


if __name__ == "__main__":
    main()









































































































































































